<div style="max-width:560px;margin:0 auto;background:#fff;border-radius:16px;overflow:hidden;border:1px solid #e7e7ea;">
  <div style="padding:20px 24px;background:#f43f5e;color:#fff;">
    <strong style="font-size:18px;">Yêu cầu báo giá mới #<%= @lead.id %></strong>
  </div>
  <table style="width:100%;border-collapse:collapse;font-size:15px;">
    <% [
      ["Khách hàng", @lead.name.presence || "—"],
      ["Số điện thoại", @lead.phone],
      ["Loại sự kiện", @event_type_name],
      ["Ngày tổ chức", @lead.event_date.strftime("%d/%m/%Y")],
      ["Số lượng khách", @lead.guests],
      ["Địa điểm", @lead.location],
      ["Thiết bị cần thuê", @equipment.any? ? @equipment.join(", ") : "—"],
      ["Ghi chú", @lead.note.presence || "—"],
      ["Gửi từ", @source],
      ["Thời gian gửi", @lead.created_at.strftime("%H:%M %d/%m/%Y")]
    ].each do |label, value| %>
      <tr>
        <td style="padding:10px 24px;border-bottom:1px solid #f0f0f2;color:#6b6f7a;width:150px;vertical-align:top;"><%= label %></td>
        <td style="padding:10px 24px;border-bottom:1px solid #f0f0f2;white-space:pre-line;"><%= value %></td>
      </tr>
    <% end %>
  </table>
  <div style="padding:20px 24px;">
    <a href="tel:<%= @lead.phone.delete(" ") %>" style="display:inline-block;padding:10px 18px;border-radius:999px;background:#f43f5e;color:#fff;text-decoration:none;font-weight:bold;">Gọi khách</a>
    <a href="<%= @admin_url %>" style="display:inline-block;margin-left:8px;padding:10px 18px;border-radius:999px;border:1px solid #d9d9de;color:#1d2027;text-decoration:none;">Mở trang quản trị</a>
  </div>
</div>
