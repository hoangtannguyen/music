# Copy to .env and fill in (development only; .env is git-ignored).
# On Render, set these in the dashboard instead (see render.yaml).

# Email option 1 - Brevo HTTPS API (needed on Render free, which blocks outbound SMTP).
# When BREVO_API_KEY is set it is used instead of SMTP.
BREVO_API_KEY=
# Must be a verified sender in Brevo
MAIL_FROM=

# Email option 2 - SMTP (local development, or paid Render instances)
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=gmail.com
SMTP_USERNAME=your-account@gmail.com
# Gmail: use an App Password (Google Account > Security > 2-Step Verification > App passwords), not the login password
SMTP_PASSWORD=

# Who receives "new quote request" emails
LEAD_NOTIFY_EMAIL=
# Used for the admin link in emails
FRONTEND_URL=http://localhost:5173
